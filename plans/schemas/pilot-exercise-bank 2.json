        { "id": "u02-i05", "source": "I want to go, but I don't want to drive.", "canonical": "Quiero ir, pero no quiero manejar.", "primaryTag": "opener.quiero.neg", "stackedTags": ["opener.quiero"] },
        { "id": "u02-i06", "source": "I don't want to sleep yet. I want to read a little.", "canonical": "No quiero dormir todavía. Quiero leer un poco.", "primaryTag": "opener.quiero.neg", "stackedTags": ["opener.quiero"] },
        { "id": "u02-i07", "source": "I want to try, but I don't want to fail.", "canonical": "Quiero intentar, pero no quiero fallar.", "primaryTag": "opener.quiero.neg", "stackedTags": ["opener.quiero"] },
        { "id": "u02-i08", "source": "I don't want to cancel. I want to continue.", "canonical": "No quiero cancelar. Quiero continuar.", "primaryTag": "opener.quiero.neg", "stackedTags": ["opener.quiero"] },
        { "id": "u02-i09", "source": "I want to finish now. I don't want to wait any longer.", "canonical": "Quiero terminar ahora. No quiero esperar más.", "primaryTag": "opener.quiero.neg", "stackedTags": ["opener.quiero"] },
        { "id": "u02-i10", "source": "I don't want to buy anything. I want to save money.", "canonical": "No quiero comprar nada. Quiero ahorrar dinero.", "primaryTag": "opener.quiero.neg", "stackedTags": ["opener.quiero"] },
        { "id": "u02-i11", "source": "I want to call, but I don't want to talk right now.", "canonical": "Quiero llamar, pero no quiero hablar ahora.", "primaryTag": "opener.quiero.neg", "stackedTags": ["opener.quiero"] },
        { "id": "u02-i12", "source": "I don't want to open the store today. I want to rest.", "canonical": "No quiero abrir la tienda hoy. Quiero descansar.", "primaryTag": "opener.quiero.neg", "stackedTags": ["opener.quiero"] },
        { "id": "u02-i13", "source": "I want to finish, but I don't want to work late.", "canonical": "Quiero terminar, pero no quiero trabajar hasta tarde.", "primaryTag": "opener.quiero.neg", "stackedTags": ["opener.quiero"] },
        { "id": "u02-i14", "source": "I don't want to eat a lot. I want to try something small.", "canonical": "No quiero comer mucho. Quiero probar algo pequeño.", "primaryTag": "opener.quiero.neg", "stackedTags": ["opener.quiero"] },
