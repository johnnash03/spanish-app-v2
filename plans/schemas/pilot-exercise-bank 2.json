      "items": [
        { "id": "u08-i01", "source": "I want to watch it (the film).", "canonical": "Quiero verla.", "primaryTag": "clitic.do.sg.attach", "stackedTags": [] },
        { "id": "u08-i02", "source": "I want to cancel it (the appointment).", "canonical": "Quiero cancelarla.", "primaryTag": "clitic.do.sg.attach", "stackedTags": [] },
        { "id": "u08-i03", "source": "I want to find her.", "canonical": "Quiero encontrarla.", "primaryTag": "clitic.do.sg.attach", "stackedTags": [] },
        { "id": "u08-i04", "source": "I want to read it (the book) tonight.", "canonical": "Quiero leerlo esta noche.", "primaryTag": "clitic.do.sg.attach", "stackedTags": ["opener.quiero"] },
        { "id": "u08-i05", "source": "I want to buy it (the ticket) tomorrow.", "canonical": "Quiero comprarlo mañana.", "primaryTag": "clitic.do.sg.attach", "stackedTags": ["opener.quiero"] },
        { "id": "u08-i06", "source": "I want to open it (the letter) now.", "canonical": "Quiero abrirla ahora.", "primaryTag": "clitic.do.sg.attach", "stackedTags": ["opener.quiero"] },
        { "id": "u08-i07", "source": "I want to try it (the dish).", "canonical": "Quiero probarlo.", "primaryTag": "clitic.do.sg.attach", "stackedTags": ["opener.quiero"] },
        { "id": "u08-i08", "source": "I want to invite her.", "canonical": "Quiero invitarla.", "primaryTag": "clitic.do.sg.attach", "stackedTags": ["opener.quiero"] },
        { "id": "u08-i09", "source": "I want to visit him.", "canonical": "Quiero visitarlo.", "primaryTag": "clitic.do.sg.attach", "stackedTags": ["opener.quiero"] },
        { "id": "u08-i10", "source": "I want to call her tomorrow.", "canonical": "Quiero llamarla mañana.", "primaryTag": "clitic.do.sg.attach", "stackedTags": ["opener.quiero"] },
        { "id": "u08-i11", "source": "I want to buy it (the car) and drive it home.", "canonical": "Quiero comprarlo y manejarlo a casa.", "primaryTag": "clitic.do.sg.attach", "stackedTags": ["opener.quiero"] },
        { "id": "u08-i12", "source": "I want to find it (the key) and keep it.", "canonical": "Quiero encontrarla y guardarla.", "primaryTag": "clitic.do.sg.attach", "stackedTags": ["opener.quiero"] },
