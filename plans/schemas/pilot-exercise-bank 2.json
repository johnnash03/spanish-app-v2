      "items": [
        { "id": "u07-i01", "source": "I want to eat dinner.", "canonical": "Quiero cenar.", "primaryTag": "opener.mixed", "stackedTags": [] },
        { "id": "u07-i02", "source": "I can help.", "canonical": "Puedo ayudar.", "primaryTag": "opener.mixed", "stackedTags": [] },
        { "id": "u07-i03", "source": "I have to pay.", "canonical": "Tengo que pagar.", "primaryTag": "opener.mixed", "stackedTags": [] },
        { "id": "u07-i04", "source": "I want to eat, but I have to work first.", "canonical": "Quiero comer, pero tengo que trabajar primero.", "primaryTag": "opener.mixed", "stackedTags": ["opener.tengo-que"] },
        { "id": "u07-i05", "source": "I must go, but I can come back later.", "canonical": "Debo ir, pero puedo volver más tarde.", "primaryTag": "opener.mixed", "stackedTags": ["opener.puedo"] },
        { "id": "u07-i06", "source": "I can wait, but I want to eat first.", "canonical": "Puedo esperar, pero quiero comer primero.", "primaryTag": "opener.mixed", "stackedTags": ["opener.quiero"] },
        { "id": "u07-i07", "source": "I have to leave now. I want to come back tomorrow.", "canonical": "Tengo que salir ahora. Quiero volver mañana.", "primaryTag": "opener.mixed", "stackedTags": ["opener.quiero"] },
        { "id": "u07-i08", "source": "I'm going to sleep early. I must wake up at six.", "canonical": "Voy a dormir temprano. Debo despertar a las seis.", "primaryTag": "opener.mixed", "stackedTags": ["opener.debo"] },
        { "id": "u07-i09", "source": "I can finish this. I just have to try.", "canonical": "Puedo terminar esto. Solo tengo que intentar.", "primaryTag": "opener.mixed", "stackedTags": ["opener.tengo-que"] },
        { "id": "u07-i10", "source": "I want to travel. I'm going to save money.", "canonical": "Quiero viajar. Voy a ahorrar dinero.", "primaryTag": "opener.mixed", "stackedTags": ["opener.voy-a"] },
        { "id": "u07-i11", "source": "I want to finish early. I have to leave at five. I can work fast.", "canonical": "Quiero terminar temprano. Tengo que salir a las cinco. Puedo trabajar rápido.", "primaryTag": "opener.mixed", "stackedTags": ["opener.tengo-que", "opener.puedo"] },
        { "id": "u07-i12", "source": "I have to go to the market. I want to buy food. I'm going to cook tonight.", "canonical": "Tengo que ir al mercado. Quiero comprar comida. Voy a cocinar esta noche.", "primaryTag": "opener.mixed", "stackedTags": ["opener.quiero", "opener.voy-a"] },
        { "id": "u07-i13", "source": "I can help. I want to explain the problem. I'm going to start now.", "canonical": "Puedo ayudar. Quiero explicar el problema. Voy a empezar ahora.", "primaryTag": "opener.mixed", "stackedTags": ["opener.quiero", "opener.voy-a"] },
        { "id": "u07-i14", "source": "I must call the doctor. I have to leave at nine, and I want to eat before I go.", "canonical": "Debo llamar al médico. Tengo que salir a las nueve y quiero comer antes de ir.", "primaryTag": "opener.mixed", "stackedTags": ["opener.tengo-que", "opener.quiero"] },
        { "id": "u07-i15", "source": "I'm going to the store. I can buy everything. I have to be back by noon.", "canonical": "Voy a ir a la tienda. Puedo comprar todo. Tengo que volver antes del mediodía.", "primaryTag": "opener.mixed", "stackedTags": ["opener.puedo", "opener.tengo-que"] }
      ]
